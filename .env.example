# --- Hugging Face ---
# `hf auth login` ile giriş yaptıysanız boş bırakabilirsiniz (script'ler
# cache'teki token'ı otomatik kullanır). Yine de burada tutmak isterseniz doldurun.
HF_TOKEN=

# Hızlı upload/download için (opsiyonel ama önerilir, hf_transfer kurulu)
HF_HUB_ENABLE_HF_TRANSFER=1

# --- HF profilinizde oluşturulacak repo id'leri (kullanici-adi/repo-adi) ---
DATASET_REPO_ID=kullanici-adi/domain-adi-dataset
TOKENIZER_REPO_ID=kullanici-adi/domain-adi-bpe-tokenizer
LORA_REPO_ID=kullanici-adi/domain-adi-lora

# Ek ödev: kimlik veri seti / adaptörü
IDENTITY_DATASET_REPO_ID=kullanici-adi/identity-finetune-felsefe
IDENTITY_LORA_REPO_ID=kullanici-adi/identity-lora-felsefe

# --- Eğitim ayarları ---
# Qwen3.5-4B: hybrid (gated-deltanet + full attention) dense model, post-trained
# (chat-ready), 8GB VRAM'e 4bit+LoRA ile rahat sığar. unsloth.FastModel ile yüklenir
# (bkz. common/lora_trainer.py) — FastLanguageModel değil, çünkü bu mimari
# multimodal (image-text-to-text) olarak paketlenmiş; biz sadece metin kullanıyoruz.
BASE_MODEL=unsloth/Qwen3.5-4B

WANDB_DISABLED=true
TOKENIZERS_PARALLELISM=false

# --- Ödev 1: scraping ---
# Hesap/API anahtarı gerekmiyor. scrape_reddit.py (r/Turkey, Playwright/headless
# Chromium ile) ve scrape_eksisozluk.py (requests+BeautifulSoup) hesapsız çalışır,
# bu yüzden burada tutulacak bir secret yok.

# Ödev 6: felsefeye özel 100 soruluk benchmark verisi (HF Dataset olarak push edilecek)
FELSEFE_BENCHMARK_REPO_ID=kullanici-adi/felsefe-benchmark-100

# --- Ödev 7: tool calling + HF Spaces ---
# Yayınlanacak Space reposu (deploy_space.py bunu oluşturur).
SPACE_REPO_ID=kullanici-adi/tool-calling-hava-durumu

# Arka uç seçimi:
#   yerel -> modeli Space içinde (ücretsiz ZeroGPU) transformers ile çalıştırır
#   api   -> HF Inference Providers (kredi harcar)
TOOL_BACKEND=yerel

# Kullanılacak model. Sohbet şablonu tool calling desteklemeli.
#   yerel arka uç için: Qwen/Qwen2.5-7B-Instruct (ZeroGPU'ya rahat sığar)
#   api arka ucu için : Qwen/Qwen3-Coder-30B-A3B-Instruct
TOOL_MODEL=Qwen/Qwen2.5-7B-Instruct

# Opsiyonel: api arka ucunda belirli bir sağlayıcıya sabitlemek için
# (nebius, cerebras, together...). Boş bırakılırsa "auto".
HF_PROVIDER=

# Opsiyonel kaçış yolu: HF Inference kredisi bittiğinde OpenAI uyumlu başka bir
# endpoint kullanmak için. İkisi de doluysa ajan HF router'ı yerine burayı kullanır.
TOOL_BASE_URL=
TOOL_API_KEY=

# Ödev 7 için de HF_TOKEN gerekir (Inference Providers çağrıları). Token'da
# "Make calls to Inference Providers" izni açık olmalı; salt-okunur token yetmez.

# --- Ödev 8: veritabanına yazan tool calling ajanı (felsefe kitapçısı) ---
# Yayınlanacak Space reposu (hafta8_veritabani_ajani/deploy_space.py bunu oluşturur).
# 7. haftanınkinden ayrı bir repo; TOOL_BACKEND ve TOOL_MODEL ikisinde de ortak.
SPACE_REPO_ID_KITAPCI=kullanici-adi/kitapci-siparis-ajani

# SQLite dosyasının yolu. Boş bırakılırsa: kalıcı disk (/data) varsa oraya,
# yoksa hafta8_veritabani_ajani/kitapci.db. Dosya yoksa şema + tohum katalog
# ilk çalıştırmada kurulur (veritabani.py), elle bir adım gerekmez.
KITAPCI_DB=
