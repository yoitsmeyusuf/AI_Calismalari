# --- Hugging Face ---
# `hf auth login` ile giriş yaptıysanız boş bırakabilirsiniz (script'ler
# cache'teki token'ı otomatik kullanır). Yine de burada tutmak isterseniz doldurun.
HF_TOKEN=

# Hızlı upload/download için (opsiyonel ama önerilir, hf_transfer kurulu)
HF_HUB_ENABLE_HF_TRANSFER=1

# --- HF profilinizde oluşturulacak repo id'leri (kullanici-adi/repo-adi) ---
DATASET_REPO_ID=kullanici-adi/domain-adi-dataset
TOKENIZER_REPO_ID=kullanici-adi/domain-adi-bpe-tokenizer
LORA_REPO_ID=kullanici-adi/domain-adi-lora

# Ek ödev: kimlik veri seti / adaptörü
IDENTITY_DATASET_REPO_ID=kullanici-adi/identity-finetune-felsefe
IDENTITY_LORA_REPO_ID=kullanici-adi/identity-lora-felsefe

# --- Eğitim ayarları ---
# Qwen3.5-4B: hybrid (gated-deltanet + full attention) dense model, post-trained
# (chat-ready), 8GB VRAM'e 4bit+LoRA ile rahat sığar. unsloth.FastModel ile yüklenir
# (bkz. common/lora_trainer.py) — FastLanguageModel değil, çünkü bu mimari
# multimodal (image-text-to-text) olarak paketlenmiş; biz sadece metin kullanıyoruz.
BASE_MODEL=unsloth/Qwen3.5-4B

WANDB_DISABLED=true
TOKENIZERS_PARALLELISM=false

# --- Ödev 1: scraping ---
# Hesap/API anahtarı gerekmiyor. scrape_reddit.py (r/Turkey, Playwright/headless
# Chromium ile) ve scrape_eksisozluk.py (requests+BeautifulSoup) hesapsız çalışır,
# bu yüzden burada tutulacak bir secret yok.

# Ödev 6: felsefeye özel 100 soruluk benchmark verisi (HF Dataset olarak push edilecek)
FELSEFE_BENCHMARK_REPO_ID=kullanici-adi/felsefe-benchmark-100
